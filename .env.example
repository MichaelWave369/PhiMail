# Copy this to .env.local and run the bridge with env vars loaded by Node 22.
# Google Cloud Console: enable Gmail API, create OAuth Web application.
# Authorized redirect: http://127.0.0.1:5173/auth/google/callback
# This is an EXPERIMENTAL read-only Gmail connector, not a hosted mail provider.

BRIDGE_PUBLIC_ORIGIN=http://127.0.0.1:5173
BRIDGE_LISTEN_HOST=127.0.0.1
BRIDGE_PORT=8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NEVER commit credentials to GitHub. Browser code must never contain secrets.

# Optional LOCAL PhiID Keycloak pilot. Disabled by default. Never use in production.
PHIMAIL_LOCAL_PHIID=0

# R6: Optional PERSONAL Outlook/Microsoft account lab. Disabled without both fields.
# Register a Web callback at http://127.0.0.1:5173/auth/microsoft/callback.
# An HTTP 127.0.0.1 callback may require an Entra app-manifest edit.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
